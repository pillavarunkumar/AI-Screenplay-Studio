# Copy to .env.local and fill in. These values are server-only.
# Never prefix a secret with NEXT_PUBLIC_ — that would ship it to the browser.

# Required. Any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_MODEL=

# Optional. Point this at your provider's /v1 base URL.
LLM_BASE_URL=https://api.openai.com/v1

# Optional knobs. Defaults shown below.
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT=30
LLM_RATE_WINDOW_MS=60000

# Optional. SQLite file for accounts and saved stories (default: ./data/studio.db).
# Put this on a persistent disk in production.
DATABASE_PATH=

# Optional. Store accounts and stories in Supabase instead of the local SQLite file.
# Run supabase/schema.sql in the Supabase SQL editor first. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, browser-safe. Not used by the app yet.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. For reasoning models such as gpt-oss: "low" cuts tokens a lot (a full "write my story"
# run costs roughly half) and is usually plenty for structured writing. Leave blank for the default.
LLM_REASONING_EFFORT=

# ---- Provider presets (any OpenAI-compatible chat-completions API works) ---------------
# Check a provider before trusting it with a story:   npm run llm:check
# List the models your key can use:                   curl -s "$LLM_BASE_URL/models" -H "Authorization: Bearer $LLM_API_KEY"
#
#   OpenAI   LLM_BASE_URL=https://api.openai.com/v1
#   Gemini   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq     LLM_BASE_URL=https://api.groq.com/openai/v1
#
# Use a stronger model just for the writing steps (story, characters, scenes, scripts, polish,
# camera plans) and a cheaper one for notes, translation and storyboards. Every LLM_WRITING_*
# setting falls back to the matching LLM_* setting when left blank.
LLM_WRITING_API_KEY=
LLM_WRITING_BASE_URL=
LLM_WRITING_MODEL=
LLM_WRITING_REASONING_EFFORT=
LLM_WRITING_TIMEOUT_MS=
# Some newer models only accept their default temperature. Put "default" to stop sending it.
LLM_TEMPERATURE=
LLM_WRITING_TEMPERATURE=
